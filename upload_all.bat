@echo off
echo 1. Tracking Lumerical data with DVC...
dvc add results/metrics results/plots carriers simulations

echo 2. Pushing datasets to cloud storage...
dvc push

echo 3. Staging code and DVC trackers for Git...
git add -A

set msg=
set /p msg="Enter your commit message: "
if "%msg%"=="" set "msg=Update scripts and data"

echo 4. Committing and Pushing to GitHub...
git commit -m "%msg%"
git push origin main

echo Done! Code is on GitHub, data is backed up via DVC.





@REM  git checkout <commit_hash>
@REM  This instantly reverts your Python scripts to the old version. It also reverts your .dvc tracking files to the old version.

@REM  Step 2: Restore the Data
@REM  Tell DVC to read those newly reverted .dvc files and fetch the matching heavy data.

@REM  Bash
@REM  dvc pull
@REM  DVC instantly deletes your current Lumerical files and downloads the exact .ldev, .mat, and . png files that were generated by that specific old code.